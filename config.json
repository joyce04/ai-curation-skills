{
  "_comment": "Edit this file to change what the digest watches. Topics drive both arXiv queries and blog-item routing. Keywords are matched against paper titles/abstracts and post titles/summaries -- prefer specific phrases ('LLM inference') over bare words ('inference'), which match unrelated work. Run scripts/fetch.py --validate-feeds after adding feeds.",
  "lookback_days": 7,
  "max_items_per_topic": 12,
  "candidate_pool_per_topic": 25,
  "topics": [

    {
      "name": "Document extraction to knowledge graphs",
      "_comment": "The full pipeline: parse -> extract -> resolve entities -> build graph. If this floods, split the parsing keywords off into their own topic.",
      "keywords": [
        "OCR",
        "document parsing",
        "document understanding",
        "layout analysis",
        "table extraction",
        "information extraction",
        "relation extraction",
        "named entity recognition",
        "entity resolution",
        "entity linking",
        "record linkage",
        "knowledge graph construction",
        "ontology learning",
        "schema matching",
        "coreference resolution"
      ],
      "arxiv_categories": [
        "cs.CL",
        "cs.IR",
        "cs.DB",
        "cs.CV"
      ]
    },
    {
      "name": "Agent backend latency",
      "_comment": "Latency/throughput for agent-shaped traffic, not single-request serving. Bare 'latency' is deliberately excluded -- it matches all of networking.",
      "keywords": [
        "inference latency",
        "tail latency",
        "time to first token",
        "TTFT",
        "prefix caching",
        "prompt caching",
        "KV cache",
        "speculative decoding",
        "continuous batching",
        "request scheduling",
        "model routing",
        "streaming response",
        "agent orchestration"
      ],
      "arxiv_categories": [
        "cs.DC",
        "cs.PF",
        "cs.AI",
        "cs.SE"
      ]
    },
    {
      "name": "Retrieval and context",
      "keywords": [
        "retrieval-augmented",
        "RAG",
        "text embedding",
        "reranking",
        "vector search",
        "long context",
        "context window",
        "dense retrieval"
      ],
      "arxiv_categories": [
        "cs.IR",
        "cs.CL"
      ]
    },
    {
      "name": "LLM post-training",
      "keywords": [
        "RLHF",
        "DPO",
        "preference optimization",
        "reward model",
        "instruction tuning",
        "post-training",
        "knowledge distillation",
        "reinforcement learning from human feedback"
      ],
      "arxiv_categories": [
        "cs.CL",
        "cs.LG"
      ]
    },
    {
      "name": "Multi-Agents",
      "keywords": [
        "LLM agent",
